  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "^11.0.7",
    "@lhci/cli": "^0.15.1",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
